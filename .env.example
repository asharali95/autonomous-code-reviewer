NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL (Compose service hostname is `postgres`)
DATABASE_URL=postgresql://reviewer:reviewer@postgres:5432/reviewer

# Shared secret for n8n → backend orchestration API
N8N_API_TOKEN=

# GitHub App (do not commit real values)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github_app_private_key.pem
# Alternatively, PEM text with literal \n sequences:
# GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Optional single-tenant fallback; otherwise resolved per repository
GITHUB_INSTALLATION_ID=

# Optional tuning
MAX_PATCH_BYTES=100000
MAX_MANIFEST_FILES=200
GITHUB_API_MAX_RETRIES=3

# Cursor AI review (Dashboard → Integrations / API Keys)
CURSOR_API_KEY=
CURSOR_MODEL_ID=composer-2.5
AI_REVIEW_MAX_FILES=40
AI_REVIEW_MAX_PROMPT_CHARS=120000
